{
  "name": "astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run images:build && npm run videos:build && npm run sitemap:build && astro build",
    "preview": "astro preview",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src",
    "check": "astro check",
    "astro": "astro",
    "images:build": "node ../scripts/build-images.mjs",
    "videos:build": "node ../scripts/build-videos.mjs",
    "sitemap:build": "node ../scripts/generate-sitemap.mjs",
    "assets:audit": "node ../scripts/audit-assets.mjs",
    "assets:prune": "node ../scripts/audit-assets.mjs --delete",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@astrojs/vercel": "11.0.16",
    "@fontsource/dancing-script": "^5.2.8",
    "@fontsource/montserrat": "^5.2.5",
    "@fontsource/pinyon-script": "^5.2.8",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "astro": "7.4.1",
    "nodemailer": "10.1.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
