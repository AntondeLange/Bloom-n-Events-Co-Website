---
/**
 * Case Study: Trinity Arcade - Crafted in Trinity heritage cabinet activation.
 * Uses the Trinity proposal framework plus supplied installation imagery.
 */
import OptimizedImage from "../components/OptimizedImage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import AnchorNav from "../components/islands/AnchorNav";
import Carousel from "../components/islands/Carousel";
import SuccessStoriesCarousel from "../components/react/SuccessStoriesCarousel";
import TestimonialsCarousel from "../components/react/TestimonialsCarousel";
import StickyMobileCTA from "../components/react/StickyMobileCTA";
import { CONTACT } from "../lib/constants";

const visualEvidenceSlides = [
  {
    src: "/assets/images/Visual Storytelling/trinity-arcade-installation-context.jpeg",
    alt: "Wide context view of Trinity Arcade heritage cabinet activation beneath the illuminated ceiling",
  },
  {
    src: "/assets/images/Visual Storytelling/trinity-through-time-cabinet-wide.jpeg",
    alt: "Trinity Through Time heritage cabinet presented as a layered historical storytelling display",
  },
  {
    src: "/assets/images/Visual Storytelling/trinity-through-time-cabinet-open.jpeg",
    alt: "Open Trinity Through Time cabinet during installation showing historical research and layered content",
  },
  {
    src: "/assets/images/Visual Storytelling/trinity-watchmaker-installation-wide.jpeg",
    alt: "Watchmaker storytelling cabinet featuring clocks, tools, and brand-aligned graphics",
  },
  {
    src: "/assets/images/Visual Storytelling/trinity-watchmaker-cabinet-detail.jpeg",
    alt: "Detailed view of the watchmaker cabinet highlighting craftsmanship, timepieces, and interpretive graphics",
  },
  {
    src: "/assets/images/Visual Storytelling/trinity-photographic-finisher-cabinet-wide.jpeg",
    alt: "Photographic Finisher cabinet with cameras, framed imagery, and analogue storytelling references",
  },
  {
    src: "/assets/images/Visual Storytelling/trinity-photographic-finisher-bts.jpeg",
    alt: "Behind-the-scenes installation image of the photographic finisher cabinet being assembled",
  },
  {
    src: "/assets/images/Visual Storytelling/trinity-tailor-cabinet-wide.jpeg",
    alt: "Tailor storytelling cabinet featuring dress form, textiles, and heritage styling",
  },
  {
    src: "/assets/images/Visual Storytelling/trinity-tailor-central-detail.jpeg",
    alt: "Central detail of the tailor cabinet showing draped fabric, tailoring references, and premium finishing",
  },
  {
    src: "/assets/images/Visual Storytelling/trinity-tailor-installation-side.jpeg",
    alt: "Side view of Trinity Arcade tailor installation within the arcade environment",
  },
].map((slide) => ({ type: "image" as const, ...slide }));
---

<BaseLayout
  title="Success Story: Crafted in Trinity | Heritage Cabinet Activation | Bloom'n Events Co"
  description="How Bloom'n Events Co transformed Trinity Arcade's preserved heritage cabinets into an experiential placemaking system celebrating craft, heritage, and specialist retail."
  path="/case-study-trinity-crafted-in-trinity"
>
  <p class="visually-hidden">Success Story: Crafted in Trinity</p>

  <section class="hero-section" aria-label="Hero">
    <div class="hero-background">
      <OptimizedImage
        src="/assets/images/Visual Storytelling/trinity-arcade-installation-context.jpeg"
        alt="Crafted in Trinity heritage cabinet activation in Trinity Arcade"
        class="hero-image"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        sizes="100vw"
        width="1600"
        height="900"
      />
    </div>
    <div class="hero-overlay" aria-hidden="true" />
    <div class="hero-content">
      <div class="w-full max-w-4xl px-4 text-center md:px-6">
        <h1 class="hero-headline">
          Crafted in Trinity
        </h1>
        <p class="hero-subhead">
          A heritage cabinet activation that turned Trinity Arcade into a trail of discovery.
        </p>
        <p class="hero-subhead">
          How Bloom'n Events Co transformed preserved Art Deco cabinets into an experiential placemaking system celebrating craft, heritage, and specialist retail.
        </p>
      </div>
    </div>
  </section>

  <AnchorNav
    links={[
      { href: "#overviewHeading", label: "Overview" },
      { href: "#ourRoleHeading", label: "Our Role" },
      { href: "#conceptHeading", label: "Concept" },
      { href: "#storiesHeading", label: "Story Themes" },
      { href: "#outcomeHeading", label: "Outcome" },
      { href: "#testimonialsHeading", label: "Testimonials" },
    ]}
    client:idle
  />

  <section class="section-main">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <section class="mb-5" aria-labelledby="overviewHeading">
        <h2 id="overviewHeading" class="heading-blush-bg mb-4">Overview</h2>
        <div class="card mb-4" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px;">
          <div class="card-body">
            <p class="text-charcoal mb-3">Trinity Arcade holds some of Perth's most distinctive retail heritage. Its preserved Art Deco cabinets are iconic architectural features, but they also presented a placemaking challenge: beautiful in form, under-used in function, and largely experienced as static display infrastructure.</p>
            <p class="text-charcoal mb-3">Bloom'n Events Co developed <strong>Crafted in Trinity</strong> as a <strong>heritage cabinet activation framework</strong> that could transform those cabinets into curated miniature exhibitions. The goal was not simply to decorate the arcade, but to create immersive placemaking moments that encouraged visitors to pause, look closer, and reconnect Trinity's specialist retailers with the story of the place itself.</p>
            <p class="text-charcoal mb-0">The result is an experiential placemaking system rooted in <strong>craft, memory, heritage, and discovery</strong>, giving Trinity Arcade a stronger sense of destination while respecting its built identity.</p>
          </div>
        </div>
      </section>

      <section class="mb-5" aria-labelledby="ourRoleHeading">
        <h2 id="ourRoleHeading" class="heading-blush-bg mb-4">Our Role</h2>
        <div class="card mb-4" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px;">
          <div class="card-body">
            <p class="text-charcoal mb-3">Bloom'n Events Co led the work from placemaking strategy through to cabinet-by-cabinet visual execution, building a modular concept that could celebrate multiple tenants while remaining coherent as a single Trinity Arcade experience.</p>
            <ul class="text-charcoal mb-0 pl-4 md:pl-[120px] columns-1 md:columns-2 gap-4 md:gap-8">
              <li>Concept development and narrative framing</li>
              <li>Creative direction for the <em>Crafted in Trinity</em> platform</li>
              <li>Cabinet theme development and story mapping</li>
              <li>Graphic design and interpretive content design</li>
              <li>Display styling, object curation, and fabrication planning</li>
              <li>Retailer integration and place-based experience design</li>
              <li>Installation planning and onsite execution</li>
              <li>Future seasonal refresh strategy</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="mb-5" aria-labelledby="conceptHeading">
        <h2 id="conceptHeading" class="heading-blush-bg mb-4">Concept Development: Crafted in Trinity</h2>
        <div class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
          <div class="card shadow" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px;">
            <div class="card-body">
              <p class="text-charcoal mb-3"><strong>Crafted in Trinity</strong> was developed as a simple, memorable title that connected specialist retail craft directly to place. The framework draws on museum display logic, Art Deco composition, and heritage interpretation to turn each cabinet into a self-contained but connected story world.</p>
              <p class="text-charcoal mb-3">The strategic goals were clear:</p>
              <ul class="text-charcoal mb-3 pl-4 md:pl-[120px] columns-1 md:columns-2 gap-4 md:gap-8">
                <li>disrupt and enrich the customer journey</li>
                <li>showcase Trinity's distinctive retailers</li>
                <li>celebrate the arcade's modern heritage positioning</li>
                <li>strengthen Trinity Arcade as a destination</li>
              </ul>
              <p class="text-charcoal mb-0">Rather than treating the cabinets as signage holders, the concept repositions them as <strong>keepers of the craft trail</strong>: places where visitors encounter skill, memory, and history through layered objects, lighting, typography, and immersive environmental cues.</p>
            </div>
          </div>

          <div class="card shadow" style="background-color: var(--color-charcoal); border: 2px solid var(--color-gold); border-radius: 12px;">
            <div class="card-body">
              <h3 class="text-gold mb-3 text-center">Visual Direction</h3>
              <ul class="mb-0 pl-4 text-white md:pl-8">
                <li>warm museum-style lighting</li>
                <li>existing brass and heritage finishes</li>
                <li>custom layered objects and textures</li>
                <li>freestanding product and artefact displays</li>
                <li>digital printed image backdrops</li>
                <li>tenant-supported products and tools</li>
                <li>elegant Art Deco composition</li>
                <li>retailer information and location references</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="mb-5" aria-labelledby="storiesHeading">
        <h2 id="storiesHeading" class="heading-blush-bg mb-4">Installed Story Themes</h2>
        <div class="card mb-4" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px;">
          <div class="card-body">
            <p class="text-charcoal mb-0">The broader concept framework mapped a rotating series of retailer-led cabinet stories. The supplied installation imagery shows that framework in practice through a set of realised themes that connect tenant identity, object curation, and heritage architecture into one continuous placemaking language.</p>
          </div>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <article class="card shadow h-full" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px; overflow: hidden;">
            <OptimizedImage
              src="/assets/images/Visual Storytelling/trinity-through-time-cabinet-wide.jpeg"
              alt="Trinity Through Time cabinet within Trinity Arcade"
              class="w-full h-auto"
              loading="lazy"
              decoding="async"
              width="1200"
              height="900"
              sizes="(max-width: 768px) 100vw, 50vw"
            />
            <div class="card-body">
              <h3 class="text-gold mb-3">Trinity Through Time</h3>
              <p class="text-charcoal mb-0">This cabinet acts as the interpretive anchor of the activation, using archival imagery, timeline framing, and heritage interpretation to connect Trinity Arcade to the wider evolution of Perth. It turns the cabinet into a miniature exhibition rather than a passive display.</p>
            </div>
          </article>

          <article class="card shadow h-full" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px; overflow: hidden;">
            <OptimizedImage
              src="/assets/images/Visual Storytelling/trinity-watchmaker-installation-wide.jpeg"
              alt="Watchmaker cabinet installation in Trinity Arcade"
              class="w-full h-auto"
              loading="lazy"
              decoding="async"
              width="1200"
              height="900"
              sizes="(max-width: 768px) 100vw, 50vw"
            />
            <div class="card-body">
              <h3 class="text-gold mb-3">The Watchmaker</h3>
              <p class="text-charcoal mb-0">Timepieces, repair references, clocks, and precision tools transform this cabinet into a story about generational skill and the cultural value of repair. The cabinet reframes watchmaking as both specialist trade and heritage narrative.</p>
            </div>
          </article>

          <article class="card shadow h-full" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px; overflow: hidden;">
            <OptimizedImage
              src="/assets/images/Visual Storytelling/trinity-tailor-cabinet-wide.jpeg"
              alt="Tailor cabinet in Trinity Arcade"
              class="w-full h-auto"
              loading="lazy"
              decoding="async"
              width="1200"
              height="900"
              sizes="(max-width: 768px) 100vw, 50vw"
            />
            <div class="card-body">
              <h3 class="text-gold mb-3">The Tailor</h3>
              <p class="text-charcoal mb-0">Dress forms, draped fabric, pattern references, and sewing equipment position tailoring as a craft of form, fit, and refinement. The cabinet balances visual theatre with real trade signals, making the story legible even at a glance.</p>
            </div>
          </article>

          <article class="card shadow h-full" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px; overflow: hidden;">
            <OptimizedImage
              src="/assets/images/Visual Storytelling/trinity-photographic-finisher-cabinet-wide.jpeg"
              alt="Photographic Finisher cabinet in Trinity Arcade"
              class="w-full h-auto"
              loading="lazy"
              decoding="async"
              width="1200"
              height="900"
              sizes="(max-width: 768px) 100vw, 50vw"
            />
            <div class="card-body">
              <h3 class="text-gold mb-3">The Photographic Finisher</h3>
              <p class="text-charcoal mb-0">Vintage cameras, framed portraiture, film references, and layered display objects make this cabinet a story about analogue memory and image-making. It celebrates photography not as commodity, but as the craft of preserving time.</p>
            </div>
          </article>
        </div>

        <div class="card mt-4" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px;">
          <div class="card-body">
            <p class="text-charcoal mb-0">The original framework also allowed for additional retailer stories and future rotations, giving Trinity Arcade a repeatable system rather than a one-off aesthetic treatment. That strategic flexibility is one of the concept's strongest commercial advantages.</p>
          </div>
        </div>
      </section>

      <section class="mb-5" aria-labelledby="seasonalHeading">
        <h2 id="seasonalHeading" class="heading-blush-bg mb-4">Seasonal Evolution Strategy</h2>
        <div class="grid gap-4 lg:grid-cols-[0.95fr_1.05fr] lg:items-stretch">
          <div class="card shadow h-full" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px;">
            <div class="card-body">
              <p class="text-charcoal mb-3">A core strength of the proposal was its built-in longevity. Rather than freezing the cabinets as static installations, Bloom'n Events Co designed the system to support <strong>quarterly refreshes, new retailer features, and seasonal placemaking layers</strong> while retaining the same cabinet framework.</p>
              <p class="text-charcoal mb-2"><strong>This creates a living feature that can:</strong></p>
              <ul class="text-charcoal mb-0 pl-4 md:pl-[120px] columns-1 md:columns-2 gap-4 md:gap-8">
                <li>keep the arcade visually fresh for repeat visitors</li>
                <li>deliver ongoing exposure for specialist tenants</li>
                <li>create new social and marketing moments</li>
                <li>reinforce Trinity's modern heritage position over time</li>
              </ul>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2 lg:h-full lg:auto-rows-fr">
            <div class="overflow-hidden rounded shadow h-full min-h-[18rem] lg:min-h-0" style="border: 2px solid var(--color-gold); border-radius: 12px;">
              <img
                src="/assets/images/visual-storytelling/trinity-through-time-cabinet-open.jpeg"
                alt="Open Trinity Through Time cabinet during installation"
                class="block w-full h-full object-cover object-center"
                loading="lazy"
                decoding="async"
                width="900"
                height="1200"
              />
            </div>
            <div class="overflow-hidden rounded shadow h-full min-h-[18rem] lg:min-h-0" style="border: 2px solid var(--color-gold); border-radius: 12px;">
              <img
                src="/assets/images/visual-storytelling/trinity-photographic-finisher-bts.jpeg"
                alt="Behind-the-scenes view of Trinity photographic finisher cabinet installation"
                class="block w-full h-full object-cover object-center"
                loading="lazy"
                decoding="async"
                width="900"
                height="1200"
              />
            </div>
          </div>
        </div>
      </section>

      <section class="mb-5" aria-labelledby="visualEvidenceHeading">
        <h2 id="visualEvidenceHeading" class="heading-blush-bg text-center mb-4">Visual Evidence</h2>
        <div style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px; overflow: hidden;">
          <Carousel slides={visualEvidenceSlides} virtualizeThreshold={8} renderWindow={5} client:visible />
        </div>
      </section>

      <section class="mb-5" aria-labelledby="outcomeHeading">
        <h2 id="outcomeHeading" class="heading-blush-bg mb-4">Outcome</h2>
        <div class="card mb-4" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px;">
          <div class="card-body">
            <p class="text-charcoal mb-3">Crafted in Trinity demonstrates how under-used heritage infrastructure can become a strategic placemaking asset. The cabinets shift from passive architectural detail to <strong>active experiential infrastructure</strong>, enriching the visitor journey and giving Trinity Arcade a stronger sense of identity.</p>
            <ul class="text-charcoal mb-3 pl-4 md:pl-[120px] columns-1 md:columns-2 gap-4 md:gap-8">
              <li>creates reasons for visitors to pause and look closer</li>
              <li>gives specialist retailers richer experiential exposure</li>
              <li>translates heritage into a contemporary customer experience</li>
              <li>supports repeat engagement through a modular refresh model</li>
              <li>strengthens Trinity Arcade's position as a destination, not just a corridor</li>
            </ul>
            <p class="text-charcoal mb-0">Most importantly, it proves that when experiential placemaking is integrated with architecture, retail identity, and operational delivery, place begins to feel memorable in a way conventional merchandising rarely achieves.</p>
          </div>
        </div>
      </section>

      <section class="mb-5" aria-labelledby="keyInsightHeading">
        <h2 id="keyInsightHeading" class="heading-blush-bg mb-4">Key Insight</h2>
        <div class="card mb-4" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px;">
          <div class="card-body">
            <p class="text-charcoal mb-3"><strong>Heritage assets become commercial assets when they are treated as placemaking infrastructure.</strong></p>
            <p class="text-charcoal mb-0">Crafted in Trinity shows that experiential placemaking is not decorative extra work. It is a strategic way to turn architecture, tenant identity, and visitor movement into a more emotionally resonant and commercially valuable environment.</p>
          </div>
        </div>
      </section>

      <section class="mb-5" aria-labelledby="servicesHeading">
        <h2 id="servicesHeading" class="heading-blush-bg mb-4">Services Delivered</h2>
        <div class="card mb-4" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px;">
          <div class="card-body">
            <p class="text-charcoal mb-3">End-to-end services delivered to transform a heritage feature into a repeatable experiential placemaking platform:</p>
            <ul class="text-charcoal mb-0 pl-4 md:pl-[120px] columns-1 md:columns-2 gap-4 md:gap-8">
              <li>experiential placemaking strategy</li>
              <li>creative direction and concept naming</li>
              <li>heritage interpretation and story development</li>
              <li>graphic design and printed backdrop design</li>
              <li>display curation, styling, and object sourcing</li>
              <li>cabinet activation planning and installation</li>
              <li>retailer-led placemaking integration</li>
              <li>seasonal refresh framework development</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="mb-5 testimonials" aria-labelledby="testimonialsHeading">
        <h2 id="testimonialsHeading" class="heading-blush-bg mb-4">What Our Clients Say</h2>
        <TestimonialsCarousel client:visible />
      </section>

      <section class="mb-5" aria-labelledby="relatedServicesHeading">
        <h2 id="relatedServicesHeading" class="heading-blush-bg text-center mb-4">Related Services</h2>
        <div class="grid gap-4 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
          <article class="card shadow" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px;">
            <div class="card-body text-center">
              <h3 class="text-gold mb-3">Placemaking</h3>
              <p class="text-charcoal">Experiential environments that turn architecture, identity, and memory into commercial value.</p>
              <a href="/visual-storytelling" class="btn-gold btn-sm mt-3 inline-block">Explore Placemaking</a>
            </div>
          </article>
          <article class="card shadow" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px;">
            <div class="card-body text-center">
              <h3 class="text-gold mb-3">Custom Displays</h3>
              <p class="text-charcoal">Bespoke installations and display systems designed, fabricated, and delivered in-house.</p>
              <a href="/displays" class="btn-gold btn-sm mt-3 inline-block">View Custom Displays</a>
            </div>
          </article>
          <article class="card shadow" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px;">
            <div class="card-body text-center">
              <h3 class="text-gold mb-3">Integrated Delivery</h3>
              <p class="text-charcoal">Strategy, design, fabrication, and onsite execution held by one accountable team.</p>
              <a href="/capabilities" class="btn-gold btn-sm mt-3 inline-block">View Capabilities</a>
            </div>
          </article>
        </div>
      </section>

      <section class="section-main" aria-labelledby="relatedCaseStudiesHeading">
        <div class="mx-auto max-w-7xl px-4 md:px-6">
          <h2 id="relatedCaseStudiesHeading" class="heading-blush-bg text-center mb-5">Related Success Stories</h2>
          <SuccessStoriesCarousel client:visible />
        </div>
      </section>

      <section class="mb-5" aria-labelledby="ctaHeading">
        <div class="mx-auto max-w-4xl px-4 md:px-6">
          <h2 id="ctaHeading" class="heading-blush-bg text-center mb-5">Ready to turn your environment into a place people remember?</h2>
          <div class="card shadow" style="background-color: var(--color-champers); border: 2px solid var(--color-gold); border-radius: 12px;">
            <div class="card-body text-center p-5">
              <p class="lead text-charcoal mb-5">Whether you're activating a heritage precinct, retail environment, office lobby, or mixed-use destination, we design placemaking systems that make space feel meaningful, strategic, and worth returning to.</p>
              <div class="cta-buttons">
                <a href="/contact" class="btn-gold btn-lg me-3 mb-3">Start the Conversation</a>
                <a href="/visual-storytelling" class="btn-outline-gold btn-lg mb-3">Explore Placemaking</a>
              </div>
              <p class="text-charcoal mt-4 mb-0">
                <i class="bi bi-telephone-fill" aria-hidden="true"></i>{" "}
                <a href={`tel:${CONTACT.phone.replace(/\s/g, "")}`} class="text-gold hover:underline">{CONTACT.phone}</a>
                {" | "}
                <i class="bi bi-envelope-fill" aria-hidden="true"></i>{" "}
                <a href={`mailto:${CONTACT.email}`} class="text-gold hover:underline">{CONTACT.email}</a>
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </section>

  <StickyMobileCTA client:idle />
</BaseLayout>
